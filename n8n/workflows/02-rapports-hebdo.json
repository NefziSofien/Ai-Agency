{
  "id": "agenceRapports01",
  "name": "Agence - Rapports hebdomadaires",
  "active": false,
  "settings": { "executionOrder": "v1", "errorWorkflow": "agenceErreurs001" },
  "nodes": [
    {
      "id": "r1",
      "name": "Lundi à 8h",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0],
      "parameters": { "rule": { "interval": [{ "field": "cronExpression", "expression": "0 8 * * 1" }] } }
    },
    {
      "id": "r2",
      "name": "Lancer les rapports clients",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [260, 0],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.AGENCE_API_URL }}/automations/weekly-reports",
        "sendHeaders": true,
        "headerParameters": { "parameters": [{ "name": "X-API-Key", "value": "={{ $env.AGENCE_API_KEY }}" }] },
        "options": {}
      }
    }
  ],
  "connections": {
    "Lundi à 8h": { "main": [[{ "node": "Lancer les rapports clients", "type": "main", "index": 0 }]] }
  }
}

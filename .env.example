# Copier en .env (ou lancer scripts/init_env.sh qui génère les secrets).

TZ=Africa/Tunis
ADMIN_EMAIL=admin@agence.local
ADMIN_PASSWORD=change-me

# ---- OmniRoute (sur l'hôte) ----
OMNIROUTE_BASE_URL=http://localhost:20128/v1
# Clé par défaut, utilisée quand un client n'a pas sa propre clé OmniRoute.
OMNIROUTE_API_KEY=
# Noms de modèles ou de combos OmniRoute par rôle.
# "auto" fonctionne dès qu'un fournisseur est connecté ; passer ensuite aux combos
# créés par scripts/omniroute_setup.py (agence-strategie, agence-redaction, agence-rapide).
MODEL_STRATEGIE=auto
MODEL_REDACTION=auto
MODEL_RAPIDE=auto/fast
MODEL_EMBEDDING=
MODEL_IMAGE=
MODEL_TTS=
# native = appels de fonctions OpenAI ; prompt = outils et JSON décrits dans le prompt (fournisseurs sans tool calling)
TOOL_MODE=native
# Révisions automatiques demandées par le Brand Guardian avant validation humaine.
MAX_REVISIONS=1

# ---- API de l'agence ----
AGENCE_API_KEY=
API_PUBLIC_URL=http://localhost:8000

# ---- Postgres / Redis / stockage S3 (RustFS) ----
POSTGRES_USER=agence
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://agence:${POSTGRES_PASSWORD}@localhost:5433/agence
REDIS_PASSWORD=
S3_ACCESS_KEY=agence
S3_SECRET_KEY=
S3_ENDPOINT=http://localhost:9000
S3_BUCKET_ASSETS=assets

# ---- Langfuse ----
LANGFUSE_HOST=http://localhost:3001
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_SALT=
LANGFUSE_ENCRYPTION_KEY=
LANGFUSE_NEXTAUTH_SECRET=
CLICKHOUSE_PASSWORD=

# ---- n8n ----
N8N_ENCRYPTION_KEY=

# ---- Recherche web ----
SEARXNG_URL=http://localhost:8888
SEARXNG_SECRET=
TAVILY_API_KEY=

# ---- Postiz ----
POSTIZ_URL=http://localhost:4007
POSTIZ_API_KEY=
POSTIZ_JWT_SECRET=

# ---- CRM / emailing ----
TWENTY_URL=http://localhost:3002
TWENTY_API_KEY=
TWENTY_APP_SECRET=
LISTMONK_URL=http://localhost:9002
LISTMONK_API_USER=
LISTMONK_API_TOKEN=

# ---- Plateformes publicitaires et analytics ----
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_OAUTH_ACCESS_TOKEN=
META_ACCESS_TOKEN=
META_API_VERSION=v21.0
